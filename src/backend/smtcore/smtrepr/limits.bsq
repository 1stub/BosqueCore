declare namespace SMTLimits;

%% I am a little bit suspicious of these bounds here, as them seem to just be
%% an approximiation, so we may want to be generous in the ranges we allow then
%% just forcefully promote to next width
%% ** I found these bounds here: https://stackoverflow.com/a/79865044/21400811 **
const f16_min: Float = 65504.0f;
const f16_max: Float = -65504.0f;
const f32_min: Float = 1.2f * Float::pow(10.0f, -38.0f);
const f32_max: Float = 3.4f * Float::pow(10.0f, 38.0f);
const f64_min: Float = 2.2f * Float::pow(10.0f, -308.0f);
const f64_max: Float = 1.8f * Float::pow(10.0f, 308.0f);

const min_bvsize: Nat = 4n;
const min_float_bvsize: Nat = 16n;

function unsignedMaxHex(bvsize: Nat): CString {
    return Algorithm::while<(|Nat, CString|)>(
        (|bvsize, ''|),
        pred(st) => st.0 != 0n,
        fn(st) => (|st.0 - 4n, st.1.prepend('f')|)
    ).1;
}

function signedMinHex(bvsize: Nat): CString {
    return Algorithm::while<(|Nat, CString|)>(
        (|bvsize, ''|),
        pred(st) => st.0 != 0n,
        fn(st) => if(st.0 - 4n == 0n) 
            then (|st.0 - 4n, st.1.prepend('8')|) 
            else (|st.0 - 4n, st.1.prepend('0')|)
    ).1;
}

function signedMaxHex(bvsize: Nat): CString {
    return Algorithm::while<(|Nat, CString|)>(
        (|bvsize, ''|),
        pred(st) => st.0 != 0n,
        fn(st) => if(st.0 - 4n == 0n) 
            then (|st.0 - 4n, st.1.prepend('7')|)
            else (|st.0 - 4n, st.1.prepend('f')|)
    ).1;
}

function floatMin(bvsize: Nat): Float
{
    switch(bvsize) {
        | 16n => { return f16_min; }
        | 32n => { return f32_min; }
        | 64n => { return f64_min; }
        | _ => { abort; }
    }
}

function floatMax(bvsize: Nat): Float
{
    switch(bvsize) {
        | 16n => { return f16_max; }
        | 32n => { return f32_max; }
        | 64n => { return f64_max; }
    }
}