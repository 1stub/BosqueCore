namespace NumericOps {
    function s_natToCString(v: Nat): CString = s_nat_to_cstring;
    function s_natFromCString(str: CString): Nat = s_nat_from_cstring;
    function s_natPow(a: Nat, b: Nat): Nat = s_nat_pow;

    function s_intToCString(v: Int): CString = s_int_to_cstring;
    function s_intFromCString(str: CString): Int = s_int_from_cstring;
    function s_intPow(a: Int, b: Int): Int = s_int_pow;

    function s_bignatToCString(v: BigNat): CString = s_bignat_to_cstring;
    function s_bignatFromCString(str: CString): BigNat = s_bignat_from_cstring;
    function s_bignatPow(a: BigNat, b: BigNat): BigNat = s_bignat_pow;

    function s_bigintToCString(v: BigInt): CString = s_bigint_to_cstring;
    function s_bigintFromCString(str: CString): BigInt = s_bigint_from_cstring;
    function s_bigintPow(a: BigInt, b: BigInt): BigInt = s_bigint_pow;

    function s_floatPow(a: Float, b: Float): Float = s_float_pow;
    function s_floatSqrt(a: Float): Float = s_float_sqrt;
    function s_floatToCString(v: Float): CString = s_float_to_cstring;
    function s_floatFromCString(str: CString): Float = s_float_from_cstring;
}
